# ============================================================
# Claude API
# ============================================================
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ============================================================
# Despacho
# ============================================================
DESPACHO_NOMBRE=Vea Legal
ABOGADO_TELEFONO=+34600000000
ABOGADO_NOMBRE=Oscar

# ============================================================
# Comportamiento
# ============================================================
HISTORIAL_MAX_MENSAJES=20
SOLO_PRIVADOS=true

# ============================================================
# Transcripción de notas de voz (OpenAI Whisper) — opcional
# ============================================================
OPENAI_API_KEY=
WHISPER_MODELO=whisper-1

# ============================================================
# Google Calendar (citas y recordatorios) — opcional
# Para obtener el refresh_token:  npm run calendario:auth
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
DESPACHO_TIMEZONE=Europe/Madrid
DESPACHO_HORARIO_INICIO=10:00
DESPACHO_HORARIO_FIN=19:00
DURACION_CITA_MINUTOS=45

# ============================================================
# Recordatorios automáticos de citas (WhatsApp, 24h antes)
# Requiere que Google Calendar esté configurado.
# ============================================================
RECORDATORIOS_ACTIVADOS=true
RECORDATORIOS_HORAS_ANTES=24
RECORDATORIOS_CRON=*/30 * * * *

# ============================================================
# Notificaciones al abogado cuando el agente deriva un caso
# Slack: pega aquí la URL de un Incoming Webhook
# Email: SMTP de tu proveedor (Gmail, Outlook, etc.)
# Si dejas ambos vacíos, las derivaciones sólo se loguean.
# ============================================================
SLACK_WEBHOOK_URL=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
EMAIL_ABOGADO=

# ============================================================
# Base documental legal — el agente puede buscar y leer estos
# archivos cuando un cliente pregunta algo relacionado.
# Soporta .pdf, .docx, .txt, .md.
# ============================================================
BASE_LEGAL_PATH=D:\Base de datos Legal\oscar
BASE_LEGAL_MAX_CHARS_POR_DOC=80000

# ============================================================
# Panel web — lista y revisión de chats
# WEB_BIND=127.0.0.1 (default, SOLO localhost). Para exponer en LAN
# pon 0.0.0.0, pero SOLO detrás de un reverse proxy con TLS y rate-limit.
# ============================================================
WEB_PANEL_ACTIVADO=true
WEB_PORT=3000
WEB_BIND=127.0.0.1
WEB_USER=admin
WEB_PASS=cambia-esto

# ============================================================
# Retención RGPD (purga automática diaria a las 03:00)
# - RETENCION_CHATS_DIAS: borra conversaciones sin actividad > N días
# - RETENCION_AUDIT_DIAS: borra eventos del registro > N días
# ============================================================
RETENCION_CHATS_DIAS=90
RETENCION_AUDIT_DIAS=730
RETENCION_CRON=0 3 * * *

# ============================================================
# Límites anti-DoS de media entrante
# ============================================================
MEDIA_MAX_BYTES=20971520

# ============================================================
# Puppeteer (sólo cambiar en Docker)
# ============================================================
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
